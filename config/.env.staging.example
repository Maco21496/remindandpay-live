# Staging config template for RemindAndPay.
# Copy this server-side to:
# C:\Users\Administrator\Documents\remindandpay\staging\config\.env
#
# Do not commit real secrets. Staging must override Machine-level live values
# because the app loads folder-local config/.env with override=True.

APP_ENV=staging
ENVIRONMENT=staging
APP_PORT=8056
APP_BASE_URL=https://staging.remindandpay.com
TWILIO_WEBHOOK_BASE_URL=https://staging.remindandpay.com

# Staging must use its own database. Do not point staging at invoice_chaser.
DB_URL=mysql+pymysql://remindandpay_staging_app:REPLACE_WITH_PASSWORD@127.0.0.1/remindandpay_staging

# App/auth secrets: use staging-only values.
APP_SECRET=REPLACE_WITH_STRONG_STAGING_SECRET
APP_SECRETS_KEY=REPLACE_WITH_STAGING_16_24_OR_32_BYTE_KEY_BASE64_HEX_OR_RAW
IC_OWNER_EMAIL=admin@remindandpay.com

# Postmark staging behavior.
# Staging normally inherits machine-level Postmark account/server variables unless
# explicitly overridden later. The minimal required Postmark staging override is
# POSTMARK_DELIVERY_TYPE=Sandbox, which makes Postmark servers created by staging
# use Sandbox delivery type. Do not put real Postmark secrets in this example file.
POSTMARK_DELIVERY_TYPE=Sandbox

# Staging email safety enforced by api/app/mailer.py for Postmark sends.
EMAIL_SEND_ENABLED=0
EMAIL_RECIPIENT_OVERRIDE=admin@remindandpay.com
EMAIL_ALLOWED_RECIPIENTS=admin@remindandpay.com
EMAIL_ALLOWED_DOMAINS=remindandpay.com
EMAIL_SUBJECT_PREFIX=[STAGING]

# Twilio staging/test credentials. Prefer test credentials or a dedicated staging subaccount.
TWILIO_ACCOUNT_SID=REPLACE_WITH_STAGING_OR_TEST_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_STAGING_OR_TEST_TWILIO_AUTH_TOKEN
TWILIO_API_KEY_SID=REPLACE_WITH_STAGING_OR_TEST_TWILIO_API_KEY_SID
TWILIO_API_KEY_SECRET=REPLACE_WITH_STAGING_OR_TEST_TWILIO_API_KEY_SECRET
TWILIO_DEFAULT_COUNTRY=GB
TWILIO_VALIDATE_SIGNATURE=1
TWILIO_LOG_WEBHOOKS=1
TWILIO_PARENT_BUNDLE_SID=REPLACE_WITH_STAGING_TWILIO_PARENT_BUNDLE_SID

# Staging SMS safety. These flags require follow-up code enforcement before relying on them.
SMS_SEND_ENABLED=0
SMS_ALLOWED_RECIPIENTS=+447000000000

# Stripe must be test mode in staging.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Current server discovery found STRIPE_SIGNING_SECRET in config/.env.
# If deployment still uses that name, set a test webhook secret here too.
STRIPE_SIGNING_SECRET=whsec_REPLACE_ME
STRIPE_STARTER_SUBSCRIPTION_PRICE_ID=price_test_REPLACE_ME
STRIPE_SMS_TOPUP_10_PRICE_ID=price_test_REPLACE_ME
STRIPE_SMS_TOPUP_25_PRICE_ID=price_test_REPLACE_ME
STRIPE_SMS_TOPUP_50_PRICE_ID=price_test_REPLACE_ME
STRIPE_SMS_TOPUP_100_PRICE_ID=price_test_REPLACE_ME

# Worker/scheduler settings.
WORKER_NAME=staging-sender-1
SCHED_INTERVAL_SECONDS=60
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_POLL_SECONDS=5
OUTBOX_DRY_RUN=1

# PDF rendering, if needed on Windows.
WKHTMLTOPDF_PATH=C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe

# Docmail staging values later. Use test mode only and keep disabled by default.
DOCMAIL_ENV=test
DOCMAIL_SEND_ENABLED=0
DOCMAIL_API_USERNAME=REPLACE_LATER_WITH_TEST_USERNAME
DOCMAIL_API_PASSWORD=REPLACE_LATER_WITH_TEST_PASSWORD
