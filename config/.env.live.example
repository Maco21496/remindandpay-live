# Live config template for the future RemindAndPay live folder.
# Copy this server-side to:
# C:\Users\Administrator\Documents\remindandpay\live\config\.env
#
# Do not commit real secrets. Keep the current live database as invoice_chaser
# until a separate database rename/migration plan is approved.

APP_ENV=live
APP_PORT=8055
APP_BASE_URL=https://app.remindandpay.com
TWILIO_WEBHOOK_BASE_URL=https://app.remindandpay.com

# Current live database remains invoice_chaser for now.
DB_URL=mysql+pymysql://remindandpay_live_app:REPLACE_WITH_PASSWORD@127.0.0.1/invoice_chaser

# App/auth secrets: replace server-side only.
APP_SECRET=REPLACE_WITH_STRONG_LIVE_SECRET
APP_SECRETS_KEY=REPLACE_WITH_16_24_OR_32_BYTE_KEY_BASE64_HEX_OR_RAW
IC_OWNER_EMAIL=admin@remindandpay.com

# Postmark live credentials: replace server-side only.
POSTMARK_SERVER_TOKEN_DEFAULT=REPLACE_WITH_LIVE_POSTMARK_SERVER_TOKEN
POSTMARK_ACCOUNT_TOKEN_DEFAULT=REPLACE_WITH_LIVE_POSTMARK_ACCOUNT_TOKEN
POSTMARK_ACCOUNT_TOKEN=REPLACE_WITH_LIVE_POSTMARK_ACCOUNT_TOKEN
POSTMARK_WEBHOOK_URL=https://app.remindandpay.com/api/postmark/webhook
POSTMARK_WEBHOOK_USER=REPLACE_WITH_LIVE_POSTMARK_WEBHOOK_USER
POSTMARK_WEBHOOK_PASS=REPLACE_WITH_LIVE_POSTMARK_WEBHOOK_PASS
PLATFORM_FROM_NAME=Remind & Pay
PLATFORM_FROM_EMAIL=accounts@remindandpay.com
NOTIFICATIONS_EMAIL=accounts@remindandpay.com
NOTIFICATIONS_FROM_NAME=Remind & Pay
INBOUND_BASE_DOMAIN=inv.remindandpay.com

# Twilio live credentials: replace server-side only.
TWILIO_ACCOUNT_SID=REPLACE_WITH_LIVE_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_LIVE_TWILIO_AUTH_TOKEN
TWILIO_API_KEY_SID=REPLACE_WITH_LIVE_TWILIO_API_KEY_SID
TWILIO_API_KEY_SECRET=REPLACE_WITH_LIVE_TWILIO_API_KEY_SECRET
TWILIO_DEFAULT_COUNTRY=GB
TWILIO_VALIDATE_SIGNATURE=1
TWILIO_LOG_WEBHOOKS=0
TWILIO_PARENT_BUNDLE_SID=REPLACE_WITH_LIVE_TWILIO_PARENT_BUNDLE_SID

# Stripe live values: only set when live billing is intentionally enabled.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Current server discovery found STRIPE_SIGNING_SECRET in config/.env.
# Confirm whether this is still used before removing it from server config.
STRIPE_SIGNING_SECRET=whsec_REPLACE_ME
STRIPE_STARTER_SUBSCRIPTION_PRICE_ID=price_REPLACE_ME
STRIPE_SMS_TOPUP_10_PRICE_ID=price_REPLACE_ME
STRIPE_SMS_TOPUP_25_PRICE_ID=price_REPLACE_ME
STRIPE_SMS_TOPUP_50_PRICE_ID=price_REPLACE_ME
STRIPE_SMS_TOPUP_100_PRICE_ID=price_REPLACE_ME

# Worker/scheduler settings.
WORKER_NAME=live-sender-1
SCHED_INTERVAL_SECONDS=60
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_POLL_SECONDS=5
OUTBOX_DRY_RUN=0

# PDF rendering, if needed on Windows.
WKHTMLTOPDF_PATH=C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe

# Docmail live values later. Do not fill until Docmail live sending is intentionally enabled.
DOCMAIL_ENV=live
DOCMAIL_SEND_ENABLED=0
DOCMAIL_API_USERNAME=REPLACE_LATER
DOCMAIL_API_PASSWORD=REPLACE_LATER
